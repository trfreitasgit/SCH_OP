PORT=3000

# Tempo (ms) que um token ja validado fica em cache na memoria do servidor.
# Padrao 150000 (2,5 min). Reduz as chamadas ao Supabase por requisicao; valores
# menores encurtam a janela em que um token revogado ainda seria aceito.
# AUTH_CACHE_TTL_MS=150000

# Supabase - Projeto ORDENS
SUPABASE_URL_ORDENS=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY_ORDENS=your-service-role-key

# Supabase - Projeto AUTH
SUPABASE_URL_AUTH=https://your-auth-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY_AUTH=your-auth-service-role-key

JWT_SECRET=your-random-64-chars-secret
AUTH_PORT=3001
FRONTEND_URL=https://your-app.onrender.com
